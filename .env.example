# ============================================================
# OpenDeepWiki .env 模板（跨平台：macOS / Windows / Linux）
# 复制为 .env 后填入实际值。所有变量都可被同名环境变量覆盖。
# ============================================================

# --- Web ---
# Public Web URL used by sitemap, robots.txt, canonical URLs, social metadata
# SITE_URL=https://your-domain.example
# Sitemap cache TTL in seconds (default 3600)
# SITEMAP_REVALIDATE_SECONDS=3600

# --- Database ---
# 支持 sqlite / postgresql
DB_TYPE=sqlite
# SQLite：库文件路径（容器内）
CONNECTION_STRING=Data Source=/data/opendeepwiki.db
# PostgreSQL 示例（DB_TYPE=postgresql 时用）：
# CONNECTION_STRING=Host=postgres;Port=5432;Database=opendeepwiki;Username=opendeepwiki;Password=change-me

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-min-32-chars

# --- 本地导入路径根（跨平台）---
# OpenDeepWiki 从本地路径摄取仓库时，允许的根目录前缀（容器内路径）。
# 在 docker-compose.yaml 中由宿主机用户目录映射而来。
# macOS / Linux：默认 ${HOME}
# Windows：默认 C:\Users\<You>（在 compose 中通过 PowerShell 或 .env 显式注入）
# 这里写容器内挂载点的固定路径，宿主路径在 compose.yaml volumes 里调整。
LOCAL_IMPORT_ROOT=/host-home

# --- AI 服务（全局默认，用于 Chat）---
CHAT_API_KEY=your-chat-api-key
ENDPOINT=https://api.openai.com/v1
CHAT_REQUEST_TYPE=OpenAI

# --- Wiki 生成器 - Catalog ---
WIKI_CATALOG_MODEL=gpt-4o
WIKI_CATALOG_ENDPOINT=https://api.openai.com/v1
WIKI_CATALOG_API_KEY=your-catalog-api-key
WIKI_CATALOG_REQUEST_TYPE=OpenAI

# --- Wiki 生成器 - Content ---
WIKI_CONTENT_MODEL=gpt-4o
WIKI_CONTENT_ENDPOINT=https://api.openai.com/v1
WIKI_CONTENT_API_KEY=your-content-api-key
WIKI_CONTENT_REQUEST_TYPE=OpenAI

# --- Wiki 生成器 - Translation（可选）---
# WIKI_TRANSLATION_MODEL=gpt-4o
# WIKI_TRANSLATION_ENDPOINT=https://api.openai.com/v1
# WIKI_TRANSLATION_API_KEY=your-translation-api-key
# WIKI_TRANSLATION_REQUEST_TYPE=OpenAI

# --- Wiki 生成行为 ---
WIKI_PARALLEL_COUNT=5
WIKI_LANGUAGES=en,zh

# --- GameFrameX 工作区（C2 引入）---
# GameFrameX repo-registry.json 在容器内的挂载路径
GFX_REGISTRY_PATH=/gfx-config/repo-registry.json
# 默认工作区组 Id（用于 CLI / Web 的 bootstrap 默认值）
GFX_DEFAULT_GROUP=gfx-main
# GameFrameX.Docs 仓在容器内的输出根（LocalDocsWriter 写入此处）
GFX_DOCS_OUTPUT_ROOT=/gfx-docs

# --- 端口（与 compose.yaml 映射一致）---
# 主机端口（容器内固定 8080 / 3000）
HOST_API_PORT=18081
HOST_WEB_PORT=13000
