# ===================== 必填 =====================

# 已有远程 PostgreSQL（HK 需可达，白名单放行服务器出口 IP）
CONNECTION_STRING=Host=pg.example.com;Port=5432;Database=opendeepwiki;Username=odw;Password=改成你的

# JWT 签名密钥（48 位以上随机串；openssl rand -base64 48 生成）
# 公网部署安全底线，compose 用 Jwt__SecretKey 覆盖 appsettings 默认串
JWT_SECRET=

# Docs 仓推送（fine-grained PAT：仅 GameFrameX/Docs，Contents: Read and write）
DOC_REPO_URL=https://github.com/GameFrameX/Docs.git
DOC_REPO_USER=你的GitHub用户名
DOC_REPO_TOKEN=github_pat_xxx

# 公网域名（nginx 证书要匹配）
SITE_URL=https://odw.example.com

# ===================== 可选（有默认值） =====================
HOST_API_PORT=18081
HOST_WEB_PORT=13000
WIKI_PARALLEL_COUNT=5
WIKI_LANGUAGES=en,zh
GFX_WINDOW_START=23:00
GFX_WINDOW_END=14:00

# AI 兜底（实际配置在 Admin 后台「系统设置」，这里只留空即可）
# CHAT_API_KEY=
# ENDPOINT=

# 镜像（默认 GHCR，由仓库 .github/workflows/docker-image.yml 构建推送）
# IMAGE_BACKEND=ghcr.io/alianblank/opendeepwiki:latest
# IMAGE_WEB=ghcr.io/alianblank/opendeepwiki-web:latest
