# OpenResty 跑在 host 网络：容器内 127.0.0.1 即宿主回环，
# web 端口已固定只绑 127.0.0.1（compose），公网不可达，无需任何防火墙规则。
# 放入 OpenResty 挂载的配置目录（conf.d / vhost），改域名与证书路径后：
#   docker exec <openresty容器名> nginx -t && docker exec <openresty容器名> nginx -s reload

server {
    listen 443 ssl http2;
    server_name odw.example.com;          # 改成真实域名

    ssl_certificate     /etc/nginx/certs/odw.fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/odw.key.pem;

    # 可选整站锁（此站仅自用管理台，对外展示走 Docs 仓 Rspress）：
    # auth_basic "odw"; auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;              # SSE 流式（AI 生成/聊天）别缓冲
        proxy_read_timeout 3600s;         # 长请求（生成/翻译）
    }
}

server {
    listen 80;
    server_name odw.example.com;
    return 301 https://$host$request_uri;
}
